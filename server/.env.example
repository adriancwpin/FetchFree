ENABLE_BANKING_APP_ID=your-app-id
ENABLE_BANKING_PRIVATE_KEY_PATH=./your-app-id.pem
CLIENT_ORIGIN=http://localhost:5173
# Must match the port in the redirect URI registered with Enable Banking (http://localhost:3000/callback).
PORT=3000
# Optional: where the SQLite database file is stored.
# DB_PATH=./data/fetchfree.db
# Optional: interface to listen on. Keep 127.0.0.1 unless you know the API is protected.
# HOST=127.0.0.1
